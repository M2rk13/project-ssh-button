<resources>
    <style name="AppTheme_Dark" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#FF3056</item>
        <item name="android:windowBackground">#0B0A10</item>
        <item name="android:navigationBarColor">#0B0A10</item>
        <item name="android:statusBarColor">#0B0A10</item>
        <item name="android:windowLightStatusBar">false</item>
